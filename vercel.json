{
  "version": 2,
  "buildCommand": "echo 'PHP application ready for deployment!'",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/PHP/(.*)",
      "dest": "/PHP/$1"
    },
    {
      "src": "/Admin/(.*)",
      "dest": "/Admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/PHP/$1"
    }
  ]
}
